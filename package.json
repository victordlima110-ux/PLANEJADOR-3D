{
	"name": "planejador-3d",
	"private": true,
	"version": "1.0.0",
	"description": "Planejador de plantas 2D e 3D em português, feito para funcionar bem no celular",
	"author": "Victor Lima",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/victordlima110-ux/PLANEJADOR-3D.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:browser": "playwright test",
		"test:watch": "vitest",
		"catalog:manifest": "node tooling/catalog-manifest.mjs",
		"catalog:check": "node tooling/catalog-manifest.mjs --check"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/three": "^0.182.0",
		"fake-indexeddb": "^6.2.5",
		"svelte": "^5.57.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"three": "^0.182.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"dxf-writer": "^1.18.4",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.1",
		"svg-pathdata": "6.0.3"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
